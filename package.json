{
  "name": "nusantara-steel-company-profile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:static": "npm run build:contact-css && tailwindcss -c ./tailwind.config.cjs -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --minify && node scripts/build-static.mjs",
    "build:contact-css": "tailwindcss -c ./tailwind.contact.config.cjs -i ./assets/css/contact-form.input.css -o ./assets/css/contact-form.css --minify",
    "dev:css": "tailwindcss -c ./tailwind.config.cjs -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "wrangler": "4.135.0",
    "tailwindcss": "3.4.17"
  }
}
